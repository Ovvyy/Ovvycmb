<Window x:Class="Ovvycmb.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ovvycmb.Overlay"
        Title="Ovvycmb Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid">
        <!-- HP Bar Widget -->
        <Border x:Name="HpBarContainer"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,20,20,0"
                Width="220"
                Background="#CC0A0F1A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <StackPanel x:Name="AccountsPanel" />
        </Border>

        <!-- Alert Widget -->
        <Border x:Name="AlertContainer"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Background="#CC1A0A0A"
                BorderBrush="#33FF4444"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,6"
                Visibility="Collapsed">
            <TextBlock x:Name="AlertText"
                       Foreground="#FFFF4444"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="Alert" />
        </Border>

        <!-- Combat Timeline Widget -->
        <Border x:Name="TimelineContainer"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                Background="#CC0A0F1A"
                BorderBrush="#334F8EF7"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" x:Name="TimelinePanel" />
        </Border>
    </Grid>
</Window>
