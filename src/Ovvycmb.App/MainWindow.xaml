<Window x:Class="Ovvycmb.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Ovvycmb"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#0A0F1A"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="BorderlessWindow" TargetType="Window" />
    </Window.Resources>

    <Grid>
        <!-- Custom Title Bar hit area for dragging -->
        <Border x:Name="TitleBarDragArea"
                Height="40"
                VerticalAlignment="Top"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Panel.ZIndex="10" />

        <!-- Window control buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Height="40"
                    Panel.ZIndex="11">
            <Button x:Name="MinimizeBtn"
                    Width="46" Height="40"
                    Content="&#x2013;"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    Click="MinimizeBtn_Click"
                    Style="{StaticResource {x:Type Button}}" />
            <Button x:Name="MaximizeBtn"
                    Width="46" Height="40"
                    Content="&#x25A1;"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Click="MaximizeBtn_Click" />
            <Button x:Name="CloseBtn"
                    Width="46" Height="40"
                    Content="&#x2715;"
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    Click="CloseBtn_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- WebView2 — full window, serves React app -->
        <wv2:WebView2 x:Name="WebView"
                      Margin="0"
                      Source="about:blank" />

        <!-- Loading overlay shown before WebView is ready -->
        <Border x:Name="LoadingOverlay"
                Background="#0A0F1A"
                Panel.ZIndex="5">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="OVVYCMB"
                           Foreground="#4F8EF7"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           LetterSpacing="8" />
                <TextBlock Text="Initializing..."
                           Foreground="#666"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
