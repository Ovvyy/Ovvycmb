{
  "name": "ovvycmb",
  "version": "0.1.0",
  "private": true,
  "description": "DOFUS Multi-Account Organizer — Premium Desktop Application",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "clean": "pnpm -r clean && find . -name 'dist' -type d -not -path '*/node_modules/*' | xargs rm -rf"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
